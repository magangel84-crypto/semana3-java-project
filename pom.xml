<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- =====================================================================
       Spring Boot 4.1.1 (Java 17+, Tomcat 11 embebido / Jakarta EE 11)
       Empaquetado WAR EJECUTABLE + vistas JSP:
         - java -jar target/login.war        -> arranca Tomcat embebido
         - deploy en Tomcat 11 externo       -> mismo artefacto
       ===================================================================== -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.example.webapp.unir</groupId>
  <artifactId>login</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>war</packaging>

  <name>login</name>
  <description>Java web app (Spring Boot WAR ejecutable con JSP) - laboratorio Semana 3</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <java.version>17</java.version>
    <!-- Versiones gestionadas por el BOM de Spring Boot 4.1.1:
         tomcat.version=11.0.24, jakarta.servlet-api=6.1.0, jstl=3.0.2/3.0.1 -->
  </properties>

  <dependencies>
    <!-- Spring MVC + Jackson + Tomcat embebido (transitivo) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Contenedor embebido en scope provided: Spring Boot lo empaqueta en
         WEB-INF/lib-provided, por lo que el WAR sigue siendo ejecutable con
         java -jar y ademas puede desplegarse en un Tomcat externo. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-tomcat</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Motor JSP (Jasper). Spring Boot NO lo incluye en el starter: sin esta
         dependencia los JSP no se compilan en el contenedor embebido. -->
    <dependency>
      <groupId>org.apache.tomcat.embed</groupId>
      <artifactId>tomcat-embed-jasper</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- JSTL (Jakarta Tags 3.0) para las etiquetas <c:if> / <c:out> de los JSP -->
    <dependency>
      <groupId>jakarta.servlet.jsp.jstl</groupId>
      <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.glassfish.web</groupId>
      <artifactId>jakarta.servlet.jsp.jstl</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Bean Validation (@Valid, @NotBlank...) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Tests: JUnit 5, AssertJ, MockMvc, TestRestTemplate -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Spring Boot 4 movio @WebMvcTest / @AutoConfigureMockMvc a este modulo,
         que NO viene incluido en spring-boot-starter-test. Version gestionada por el BOM. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>login</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
